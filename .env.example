# Copy to .env.local for local dev; set the same keys in the Vercel dashboard
# for deploys. NEVER commit real values. Anything prefixed VITE_ is bundled
# into the browser — keep secrets OUT of VITE_* names.

# ---- Public (safe in the client bundle) ----
VITE_CLARITY_ID=
VITE_GA_MEASUREMENT_ID=
# Dev proxy target for /api: "vercel" (localhost:3000), "express" (localhost:5000),
# or a full https URL (e.g. the deployed Vercel site).
VITE_API_TARGET=
# Route chat through the new concierge agent (/api/agents/concierge) instead of
# the legacy /api/chat/stream. Off by default. Requires the api/ functions to be
# running (vercel dev) or deployed with SUPABASE_*/OPENAI_API_KEY set.
VITE_AGENT_ENABLED=

# ---- Server-only secrets (never prefix with VITE_) ----

# OpenAI — chat completions + embeddings
OPENAI_API_KEY=

# Supabase — agent runtime + knowledge base.
# service_role BYPASSES RLS; server/scripts only, never the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Directus upstream — lead system-of-record (see api/_proxy.js)
UPSTREAM_BASE=https://apicellswhyfor.com/items
UPSTREAM_TOKEN=

# Resend — contact form email (see api/contact.js)
RESEND_API_KEY=
CONTACT_TO=contacto@stem-care.com
